# Copy to an ignored .env file for local work and replace the development values.
# Never use these example credentials outside an isolated local environment.
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDRESS=:8080

# Compose service settings; these names preserve the existing PostgreSQL/Redis volumes.
POSTGRES_DB=menuflow
POSTGRES_USER=menuflow_user
POSTGRES_PASSWORD=local-postgres-change-me
POSTGRES_PORT=5432
REDIS_PASSWORD=local-redis-change-me
REDIS_PORT=6379
RABBITMQ_USER=menuflow_user
RABBITMQ_PASSWORD=local-rabbitmq-change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Application connection URLs (use service names if the processes run in Compose).
DATABASE_URL=postgres://menuflow_user:local-postgres-change-me@localhost:5432/menuflow?sslmode=disable
REDIS_URL=redis://:local-redis-change-me@localhost:6379/0
RABBITMQ_URL=amqp://menuflow_user:local-rabbitmq-change-me@localhost:5672/

POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONN_MAX_IDLE_TIME=5m
POSTGRES_CONNECT_TIMEOUT=5s

REDIS_OPERATION_TIMEOUT=2s
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=0

RABBITMQ_CONNECT_TIMEOUT=5s
RABBITMQ_CONFIRM_TIMEOUT=5s
RABBITMQ_RECONNECT_MIN=1s
RABBITMQ_RECONNECT_MAX=30s
RABBITMQ_EXCHANGE=digital-ordering.events
RABBITMQ_QUEUE=digital-ordering.events
RABBITMQ_ROUTING_KEY=#

MEDIA_ROOT=./var/media
READINESS_TIMEOUT=2s
WEBSOCKET_QUEUE_SIZE=64

OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_LEASE_DURATION=30s
OUTBOX_RETRY_BASE=2s
OUTBOX_RETRY_MAX=5m
